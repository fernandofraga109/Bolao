# Variáveis para testes E2E (Playwright).
# Copie para `.env.e2e` e preencha. NUNCA versione `.env.e2e` (já está no .gitignore).
#
# Carregamento: o Playwright não lê .env automaticamente. Use uma das opções:
#   - PowerShell:  Get-Content .env.e2e | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { $env:($matches[1].Trim()) = $matches[2].Trim() } }; npm run test:e2e
#   - ou instale `dotenv` e importe em playwright.config.ts (ver tests/README.md).

# URL onde a app responde (default: dev server).
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Usuário comum de teste (para fluxos autenticados).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_USER_NAME=Usuário E2E

# Usuário admin de teste (para fluxos de administração).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Código de grupo válido (para cadastro/entrada em grupo).
E2E_GROUP_CODE=
