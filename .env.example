# Public client-side env vars (exposed to browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SCHEMA=public   # schema do banco: 'public' (prod) ou 'dev' (dev/testes)
VITE_DB_TABLE_PREFIX=         # prefixo opcional de tabelas (ex: 'v2_')
VITE_FLAG_PROVIDER=flagcdn    # provedor de bandeiras: 'flagcdn' (usa flagcdn.com) ou não definido (usa URLs do banco)

# Server-side env vars (Vercel Functions only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
FOOTBALL_DATA_TOKEN=

# Optional
GEMINI_API_KEY=
API_FOOTBALL_KEY=

# Detalhes ao vivo / minuto a minuto (api-sports.io) — opcional.
# Segunda API usada SÓ para enriquecer o "ao vivo" (relógio, eventos, árbitro,
# estádio). NÃO entra em pontuação/ranking. Limite ~20 chamadas por jogo, por
# isso o app faz o fetch espaçado (throttle de ~5min) e só com jogo ao vivo.
# FOOTBALL_API_LIVE_DATA = URL completa (inclua a liga; Copa do Mundo = league=1)
FOOTBALL_API_LIVE_DATA=https://v3.football.api-sports.io/fixtures?live=all&league=1
FOOTBALL_API_LIVE_DATA_TOKEN=
